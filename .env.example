# Telegram Work Hours Logger Bot - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED CONFIGURATION
# These settings are mandatory for the bot to function
# =============================================================================

# Telegram Bot Token
# Get this from @BotFather on Telegram after creating your bot
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz-1234567890
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Authorized User ID
# Your Telegram user ID - get this from @userinfobot
# This ensures only you can use the bot
# Format: 123456789 (numbers only)
AUTHORIZED_USER_ID=your_telegram_user_id_here

# MongoDB Connection URI
# Your MongoDB database connection string
# 
# For MongoDB Atlas (recommended):
# mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
#
# For local MongoDB:
# mongodb://localhost:27017/workhoursbot
#
# For MongoDB with authentication:
# mongodb://username:password@host:port/database
MONGODB_URI=your_mongodb_connection_string

# =============================================================================
# OPTIONAL CONFIGURATION
# These settings have defaults but can be customized
# =============================================================================

# Environment Mode
# Set to 'production' for live deployment, 'development' for local testing
# Default: development
NODE_ENV=production

# Pay Rate Configuration
# Configure hourly pay rates used for summary estimates
# PAY_RATE=45.0
# PAY_RATE_WEEKDAY=45.0
# PAY_RATE_WEEKEND=60.0
# PAY_RATE_SATURDAY=55.0
# PAY_RATE_SUNDAY=65.0
# PAY_RATE_HOLIDAY=80.0
# PAY_RATE_CURRENCY=AUD
# PAY_RATE_LOCALE=en-AU
# PAY_RATE_SYMBOL=$
# PAY_RATE_HOLIDAY_TAGS=holiday,public_holiday,public holiday
# PAY_RATE_HOLIDAY_MESSAGE=Public Holiday

# Pay Cycle Configuration
# Configure when pay cycles start and their duration
# PAY_CYCLE_START_DATE=2025-08-04
# Format: YYYY-MM-DD (recommended to be a Monday for easier tracking)
# Default: 2025-08-04 - All pay periods are calculated from this date
#
# PAY_CYCLE_LENGTH_DAYS=14
# Number of days in each pay cycle
# Default: 14 (bi-weekly/fortnightly)
# Examples: 7 (weekly), 14 (bi-weekly), 28 (4-week), 30 (monthly)

# Date Format Preference
# Configure how dates are parsed in work log messages
# DATE_FORMAT_PREFERENCE=DMY
# Options: DMY (DD/MM/YYYY, default) or MDY (MM/DD/YYYY)

# Port Number (for local development only)
# Serverless platforms ignore this setting
# Default: 3000
PORT=3000

# =============================================================================
# DEPLOYMENT-SPECIFIC SETTINGS
# Configure these based on your hosting platform
# =============================================================================

# Webhook URL (set automatically by most platforms)
# Only needed if manually configuring webhooks
# Format: https://your-app-domain.com/api/bot
# WEBHOOK_URL=https://your-app.vercel.app/api/bot

# Database Name (if not specified in connection string)
# Default: workhoursbot
# DATABASE_NAME=workhoursbot

# =============================================================================
# DEVELOPMENT & DEBUGGING
# These settings are useful for development and troubleshooting
# =============================================================================

# Log Level
# Controls how much information is logged
# Options: error, warn, info, debug
# Default: info
# LOG_LEVEL=info

# Debug Mode
# Enables additional debugging information
# Options: true, false
# Default: false
# DEBUG=false

# MongoDB Connection Options (advanced)
# Customize MongoDB connection behavior
# These override the default optimized settings
# 
# Connection timeout in milliseconds
# MONGODB_CONNECT_TIMEOUT=10000
#
# Server selection timeout in milliseconds  
# MONGODB_SERVER_SELECTION_TIMEOUT=5000
#
# Socket timeout in milliseconds
# MONGODB_SOCKET_TIMEOUT=45000
#
# Maximum pool size
# MONGODB_MAX_POOL_SIZE=1

# =============================================================================
# PLATFORM-SPECIFIC EXAMPLES
# =============================================================================

# --- VERCEL DEPLOYMENT ---
# Set these in your Vercel dashboard under Environment Variables:
# TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
# AUTHORIZED_USER_ID=987654321
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/workbot

# --- RAILWAY DEPLOYMENT ---  
# Set these in Railway dashboard under Variables:
# TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
# AUTHORIZED_USER_ID=987654321
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/workbot

# --- RENDER DEPLOYMENT ---
# Set these in Render dashboard under Environment:
# TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
# AUTHORIZED_USER_ID=987654321
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/workbot

# --- FLY.IO DEPLOYMENT ---
# Set these using fly secrets:
# fly secrets set TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
# fly secrets set AUTHORIZED_USER_ID=987654321
# fly secrets set MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/workbot"

# =============================================================================
# SECURITY NOTES
# =============================================================================

# 🔒 IMPORTANT SECURITY REMINDERS:
#
# 1. NEVER commit the actual .env file to version control
# 2. Use strong, unique passwords for MongoDB
# 3. Restrict MongoDB network access to your deployment platform
# 4. Keep your bot token secret - it provides full access to your bot
# 5. Your Telegram user ID is not sensitive but should be accurate
# 6. Use environment variables on your hosting platform, not files
# 7. Regularly rotate credentials if compromised
# 8. Enable 2FA on all related accounts (Telegram, MongoDB, hosting)

# =============================================================================
# GETTING HELP
# =============================================================================

# If you need help with configuration:
#
# 1. Check the README.md file for detailed setup instructions
# 2. Verify all values are correct (no extra spaces, quotes, etc.)
# 3. Test your MongoDB connection string separately
# 4. Ensure your bot token is valid by messaging @BotFather
# 5. Confirm your user ID with @userinfobot
# 6. Check your hosting platform's logs for error messages
#
# Common issues:
# - MongoDB connection timeouts: Check network restrictions
# - Bot not responding: Verify webhook URL is set correctly
# - Unauthorized errors: Double-check your user ID
# - 500 errors: Check environment variables are set on your platform
